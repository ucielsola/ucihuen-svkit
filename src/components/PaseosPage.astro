---
import ExcursionCard from './ExcursionCard.astro';
import { excursions } from '../lib/data/excursions';

interface Props {
	locale: string;
	m: Record<string, string>;
}

const { locale, m } = Astro.props;
---

<section id="paseos">
	<div class="limited-width">
		<h1>{m.excursions_heading}</h1>
		<p class="intro">{m.excursions_intro}</p>

		<div class="grid">
			{excursions.map((excursion) => (
				<ExcursionCard excursion={excursion} locale={locale} messages={m} />
			))}
		</div>
	</div>
</section>

<style>
	section {
		padding-block: var(--space-lg);
	}

	h1 {
		padding-block-end: 0.5rem;
		text-align: center;
		color: var(--base-color);
		margin-block-end: var(--space-sm);
	}

	.intro {
		font-size: var(--text-base);
		line-height: var(--leading-relaxed);
		color: var(--base-color);
		margin-block-end: var(--space-lg);
		max-width: 70ch;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);
		padding-block-end: var(--space-xl);
	}

	@media screen and (min-width: 1024px) {
		section {
			padding-block: var(--space-xl);
		}

		h1 {
			text-align: start;
			padding-inline-start: 2rem;
		}

		.intro {
			font-size: var(--text-base);
		}

		.grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-lg);
		}
	}
</style>
