{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"resolveJsonModule": true
	},
	"include": [
		".svelte-kit/**/*.d.ts",
		".svelte-kit/**/*.d.ts",
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte"
	],
	"exclude": ["src/lib/paraglide/**", "build/**"]
}
